# Modèle rendu en config.yaml par ../setup.sh (domaine et secret remplacés).
server:
  host: "0.0.0.0"
  port: 3000
  base_url: "https://hub.__DOMAIN__"     # sans le préfixe /admin
  cookie_secret: "__COOKIE_SECRET__"      # exactement 32 caractères
  cookie_secure: true
  cookie_max_age: 86400
  data_path: "/var/lib/headplane"

headscale:
  url: "http://headscale:8080"
  public_url: "https://hub.__DOMAIN__"
  config_path: "/etc/headscale/config.yaml"   # monté en lecture seule : affichage uniquement
  config_strict: false

integration:
  agent:
    enabled: false
  docker:
    enabled: false

# Copier en .env puis lancer ./setup.sh
DOMAIN=festival.example.com          # hub.DOMAIN = Headscale + DERP, panel.DOMAIN = dashboard
ACME_EMAIL=                          # contact Let's Encrypt (optionnel, pour les avis d'expiration)
PUBLIC_IPV4=                         # IP publique du VPS (optionnel, aide les clients à joindre le DERP)
PANEL_USER=admin                     # login du dashboard (basic auth)
HEARTBEAT_TOKEN=                     # laissé vide : généré par setup.sh, à recopier dans agent.toml (hub.api_token)
COOKIE_SECRET=                       # laissé vide : généré par setup.sh (sessions Headplane)
OPERATOR_HOSTS=regie                 # noms des postes de régie sur le tailnet (séparés par des virgules)
